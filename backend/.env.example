# AI 설정은 화면에서도 넣을 수 있습니다(맨 위 '설정' → AI 연결).
# 화면에서 넣은 값이 이 파일보다 앞섭니다. 이 파일은 관리자가 키를 미리 넣어
# 반입할 때 씁니다. 이 파일을 고치면 프로그램을 껐다 켜야 반영됩니다.
#
# 일의 무게에 따라 세 등급으로 나눠 씁니다(빠름 · 기본 · 정밀).
# 모델 칸을 비워 두면 등급별 추천값을 씁니다(2026-09 기준):
#   OpenAI  gpt-5.6-luna / gpt-5.6-terra / gpt-5.6-sol
#   Claude  claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
#   Gemini  gemini-3.5-flash-lite / gemini-3.8-flash / gemini-3.1-pro-preview
#   호환 서버는 추천값이 없습니다(기관마다 올린 모델이 다릅니다) — 이름을 직접 적습니다.

# [기본 등급] 회사: openai | claude | gemini | compat
LLM_PROVIDER=openai

# 회사별 키(쓰는 회사만 채우면 됩니다)와 기본 등급 모델(비우면 추천값)
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# [호환 서버] 회사가 아니라 주소를 고르는 공급자입니다.
# 행정안전부 AI 공통기반이 지원하는 모델(엑사원·솔라·젬마·라마·GPT-OSS 등)처럼
# OpenAI 호환 /v1/chat/completions 를 내주는 서버를 그대로 붙입니다.
# 주소는 /v1 로 끝나게 적습니다. 인증이 없는 사내 서버면 키는 비워 둡니다.
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

# [빠름·정밀 등급] 회사를 비우면 기본 등급을 그대로 따릅니다.
AI_FAST_PROVIDER=
AI_FAST_MODEL=
AI_DEEP_PROVIDER=
AI_DEEP_MODEL=
